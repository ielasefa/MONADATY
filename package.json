{
  "name": "monadaty",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:start && next dev",
    "build": "npm run db:start && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm run db:start && prisma generate",
    "db:push": "npm run db:start && prisma db push",
    "db:seed": "npm run db:start && npx tsx prisma/seed.ts",
    "db:studio": "npm run db:start && prisma studio",
    "db:start": "pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1 || (mkdir -p /home/ielasef/.monadaty-pg-sock && pg_ctl -D /home/ielasef/.monadaty-pg -l /home/ielasef/.monadaty-pg/logfile -o \"-k /home/ielasef/.monadaty-pg-sock\" start)",
    "db:stop": "pg_ctl -D /home/ielasef/.monadaty-pg stop -m fast",
    "db:status": "pg_isready -h 127.0.0.1 -p 5432",
    "postinstall": "prisma generate",
    "db:fix-images": "npx tsx scripts/fix-product-images.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "next": "15.5.19",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "resend": "^6.12.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
