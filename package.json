{
  "name": "monadaty",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:start && bash scripts/run-local-db-command.sh next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "npm run db:start && bash scripts/run-local-db-command.sh prisma db push",
    "db:seed": "npm run db:start && bash scripts/run-local-db-command.sh tsx prisma/seed.ts",
    "db:studio": "npm run db:start && bash scripts/run-local-db-command.sh prisma studio",
    "db:start": "bash scripts/db-start.sh",
    "db:stop": "bash scripts/db-stop.sh",
    "db:status": "nc -z 127.0.0.1 5432 && echo 'postgres running' || echo 'postgres not running'",
    "postinstall": "prisma generate",
    "db:fix-images": "bash scripts/run-local-db-command.sh tsx scripts/fix-product-images.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "next": "15.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "resend": "^6.12.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.5.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
