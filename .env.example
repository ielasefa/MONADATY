# ── Database (PostgreSQL) ──
# Used by both Prisma CLI and PrismaClient (via @prisma/adapter-pg).
DATABASE_URL="postgres://user:password@localhost:5432/monadaty?sslmode=disable"
# Local commands always use this loopback URL instead of DATABASE_URL.
LOCAL_DATABASE_URL="postgres://postgres@127.0.0.1:5432/monadaty?sslmode=disable"
# Production: set one CA source. Base64 is convenient for Azure App Settings.
DATABASE_CA_CERT_BASE64=""
# Local alternative to the base64 setting (do not set both):
DATABASE_CA_CERT_PATH=""
# Optional direct/CLI URL for migrations. Runtime traffic should use DATABASE_URL.
DIRECT_URL=""

# ── Persistent runtime files (recommended on Azure App Service) ──
# Existing checked-in assets remain under public/uploads; these roots are for new files.
UPLOAD_ROOT="/home/data/monadaty/uploads"
INVOICE_ROOT="/home/data/monadaty/invoices"

# ── Session Security ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-random-64-char-hex-string"

# ── App ──
# Full public URL (no trailing slash) — used for metadataBase, sitemap, robots, CSRF
APP_URL="https://monadaty.com"
# Brand name shown in <title>, navbar, footer
APP_NAME="MONADATY"
# Default meta description for the site
APP_DESCRIPTION="Premium beverage delivery across Morocco."

# ── Email (Resend) ──
RESEND_API_KEY="re_..."
EMAIL_FROM="MONADATY <orders@monadaty.com>"

# ── Backup ──
# Directory for database backups (default: <project>/backups)
BACKUP_DIR="./backups"

# ── Google Drive Upload (optional) ──
# Folder ID to upload backups to. Requires googleapis + google-auth-library.
GOOGLE_DRIVE_ID=""

# ── Cron / Scheduler ──
# Secret used to authenticate cron job webhook requests (e.g., /api/cron/cleanup)
CRON_SECRET="change-this-to-a-random-string"

# ── CSRF ──
# Comma-separated exact origins. Required in production.
ALLOWED_ORIGINS="https://monadaty.com,https://www.monadaty.com"

# ── Admin Seed Credentials ──
# Used only during `npm run db:seed` to create the initial admin account.
# Generate a strong password: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_EMAIL="admin@monadaty.com"
ADMIN_PASSWORD="change-this-to-a-strong-password"
