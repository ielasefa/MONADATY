import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import fs from 'node:fs';
import nextEnv from '@next/env';
const { loadEnvConfig } = nextEnv;
loadEnvConfig(process.cwd(),true,{info(){},error(){}});
const metadata=JSON.parse(fs.readFileSync('/tmp/monadaty-nav-qa/metadata.json','utf8'));
assert.match(metadata.database,/^monadaty_nav_qa_\d+$/);
const url=new URL(process.env.LOCAL_DATABASE_URL!);assert.notEqual(url.pathname,'/'+metadata.database);url.pathname='/'+metadata.database;
process.env.DATABASE_URL=url.href;process.env.LOCAL_DATABASE_URL=url.href;process.env.DIRECT_URL=url.href;
const {prisma}=await import('../../lib/prisma');
const {adjustProductStock}=await import('../../lib/product-stock');
const {createOrder,updateOrderStatus}=await import('../../lib/orders');
const {adjustStock,recordMovement,transferStock,receivePurchaseOrder}=await import('../../lib/inventory');
const {getAdminProductPage}=await import('../../lib/admin-product-query');
const checks:string[]=[];
async function check(name:string,fn:()=>Promise<void>){await fn();checks.push(name);console.log('PASS '+name);}
try{
 const admin=await prisma.admin.findFirstOrThrow();
 const product=await prisma.product.create({data:{id:'qa-stock-product',slug:'qa-stock-product',name:'QAProbe Pétillante Coca-Cola 25 CL مياه',sku:'QA-ÉTÉ-STOCK-25',barcode:'9998811001122',price:'25.00 DH',stock:10,status:'Active',available:true}});
 const a=await prisma.warehouse.create({data:{name:'QA Warehouse A',code:randomUUID(),isDefault:true}}),b=await prisma.warehouse.create({data:{name:'QA Warehouse B',code:randomUUID()}});
 await prisma.productWarehouseStock.createMany({data:[{productId:product.id,warehouseId:a.id,stock:6},{productId:product.id,warehouseId:b.id,stock:2}]});
 const stock=async()=> (await prisma.product.findUniqueOrThrow({where:{id:product.id}})).stock;
 const physical=async()=> (await prisma.productWarehouseStock.aggregate({where:{productId:product.id},_sum:{stock:true}}))._sum.stock!;
 const reset=async(n:number)=>{await prisma.product.update({where:{id:product.id},data:{stock:n}});await prisma.productWarehouseStock.updateMany({where:{productId:product.id},data:{stock:0}});await prisma.productWarehouseStock.updateMany({where:{productId:product.id,warehouseId:a.id},data:{stock:n}});};
 const adjust=(delta:number,operationId=randomUUID())=>adjustProductStock({productId:product.id,delta,operationId,adminId:admin.id,adminName:admin.name});
 await check('Manual decrement preserves unallocated units',async()=>{await adjust(-1);assert.equal(await stock(),9);assert.equal(await physical(),8);});
 await check('Manual stock and warehouse allocations move atomically',async()=>{await adjust(-3);assert.equal(await stock(),6);assert.equal(await physical(),6);await adjust(1);assert.equal(await stock(),7);assert.equal(await physical(),7);});
 await check('Ten simultaneous retries deduct once',async()=>{const key=randomUUID();const results=await Promise.all(Array.from({length:10},()=>adjust(-1,key)));assert.equal(results.filter(r=>!r.replayed).length,1);assert.equal(await stock(),6);assert.equal(await physical(),6);assert.equal(await prisma.productHistory.count({where:{id:key}}),1);});
 await check('Only one buyer can remove the final unit',async()=>{await reset(1);const r=await Promise.allSettled([adjust(-1),adjust(-1)]);assert.equal(r.filter(x=>x.status==='fulfilled').length,1);assert.equal(await stock(),0);assert.equal(await physical(),0);});
 await check('Invalid and excessive adjustments cannot change stock',async()=>{for(const delta of [-1,0,0.5])await assert.rejects(adjust(delta));assert.equal(await stock(),0);});
 await reset(10);
 const input={customerName:'QA Customer',customerEmail:'qa@example.test',phone:'+212600000000',city:'Casablanca',address:'QA',postalCode:'20000',subtotal:'1',shipping:'0',shippingMethod:'delivery',tax:'0',total:'1',idempotencyKey:randomUUID(),items:[{productId:product.id,name:'Untrusted',quantity:1,unitPrice:'1',totalPrice:'1'}]};
 let orderId='';
 await check('A one-unit order deducts one catalogue and warehouse unit',async()=>{const order=await createOrder(input);assert.ok('id' in order);orderId=order.id;assert.equal(await stock(),9);assert.equal(await physical(),9);});
 await check('Order retry does not deduct again',async()=>{const r=await createOrder(input);assert.ok('replayed' in r&&r.replayed);assert.equal(await stock(),9);});
 await check('Concurrent cancellations return stock once',async()=>{await Promise.all(Array.from({length:6},()=>updateOrderStatus(orderId,{orderStatus:'cancelled'})));assert.equal(await stock(),10);assert.equal(await physical(),10);});
 await check('Refund after cancellation does not inflate stock',async()=>{await updateOrderStatus(orderId,{orderStatus:'refunded'});assert.equal(await stock(),10);assert.equal(await physical(),10);});
 await check('Reopening consumes stock; cancelling restores the same allocations',async()=>{await updateOrderStatus(orderId,{orderStatus:'processing'});assert.equal(await stock(),9);assert.equal(await physical(),9);await updateOrderStatus(orderId,{orderStatus:'cancelled'});assert.equal(await stock(),10);assert.equal(await physical(),10);});
 await check('Sold-out order cannot be reopened',async()=>{await reset(0);await assert.rejects(updateOrderStatus(orderId,{orderStatus:'pending'}));assert.equal((await prisma.order.findUniqueOrThrow({where:{id:orderId}})).orderStatus,'cancelled');assert.equal(await stock(),0);});
 await check('Warehouse absolute decrease subtracts instead of adding',async()=>{await reset(8);await adjustStock({productId:product.id,warehouseId:a.id,newStock:5,reason:'QA',adminId:admin.id});assert.equal(await stock(),5);assert.equal(await physical(),5);});
 await check('Warehouse zero target is valid and overselling is rejected',async()=>{await adjustStock({productId:product.id,warehouseId:a.id,newStock:0,reason:'QA'});assert.equal(await stock(),0);await assert.rejects(recordMovement({productId:product.id,warehouseId:a.id,movementType:'OUT',quantity:1}));assert.equal(await physical(),0);});
 await check('Receipt and return increase both stock counters',async()=>{await recordMovement({productId:product.id,warehouseId:a.id,movementType:'IN',quantity:4});await recordMovement({productId:product.id,warehouseId:a.id,movementType:'REFUND',quantity:1});assert.equal(await stock(),5);assert.equal(await physical(),5);});
 await check('Internal transfer preserves global stock and failure rolls back both warehouses',async()=>{await transferStock({productId:product.id,fromWarehouseId:a.id,toWarehouseId:b.id,quantity:2});assert.equal(await stock(),5);assert.equal(await physical(),5);const before=await prisma.productWarehouseStock.findMany({where:{productId:product.id},orderBy:{id:'asc'}});await assert.rejects(transferStock({productId:product.id,fromWarehouseId:a.id,toWarehouseId:'missing',quantity:1}));assert.deepEqual(await prisma.productWarehouseStock.findMany({where:{productId:product.id},orderBy:{id:'asc'}}),before);});
 await check('Purchase receipt is atomic and cannot exceed ordered units',async()=>{const supplier=await prisma.supplier.create({data:{name:'QA supplier'}});const po=await prisma.purchaseOrder.create({data:{orderNumber:randomUUID(),supplierId:supplier.id,warehouseId:a.id,status:'Ordered',items:{create:{productId:product.id,quantity:5,remainingQuantity:5}}},include:{items:true}});await receivePurchaseOrder(po.id,[{itemId:po.items[0].id,receivedQuantity:2}]);assert.equal(await stock(),7);await assert.rejects(receivePurchaseOrder(po.id,[{itemId:po.items[0].id,receivedQuantity:8}]));assert.equal(await stock(),7);await receivePurchaseOrder(po.id,[{itemId:po.items[0].id,receivedQuantity:3}]);assert.equal(await stock(),10);assert.equal(await physical(),10);});
 for(const search of ['qaprobe petillante','coca cola 25cl','ete stock','مِيَاه','9998811001122'])await check('Search: '+search,async()=>{const r=await getAdminProductPage(new URLSearchParams({search}));assert.ok(r.products.some(p=>p.id===product.id));});
 await check('Punctuation and SQL-like input cannot become wildcards or commands',async()=>{for(const search of ['%',"'); DROP TABLE products; --"]){const r=await getAdminProductPage(new URLSearchParams({search}));assert.equal(r.pagination.total,0);}assert.ok(await prisma.product.count());});
 await check('Filters, stock sorting and pagination compose',async()=>{const r=await getAdminProductPage(new URLSearchParams({search:'qaprobe',stock:'in',sort:'stock-desc',page:'999',pageSize:'1'}));assert.equal(r.products[0].id,product.id);assert.equal(r.pagination.page,r.pagination.totalPages);});
 fs.mkdirSync('visual-qa/product-management',{recursive:true});fs.writeFileSync('visual-qa/product-management/database-checks.json',JSON.stringify({database:'isolated QA clone',checks},null,2));console.log(JSON.stringify({passed:checks.length}));
}finally{await prisma.$disconnect();await (globalThis as unknown as {pool?:{end():Promise<void>}}).pool?.end().catch(()=>{});}
